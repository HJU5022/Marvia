# 프론트(Next.js) 환경변수. 실제 값은 frontend/.env.local에만 (커밋 금지).
# NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저로 전달된다. 비밀값은 여기 두지 않는다.

# NEXT_PUBLIC_SUPABASE_URL=<...>        # Supabase 프로젝트 URL. 구글 로그인 창
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<...>   # anon key (공개 가능). 로그인·토큰 갱신
# NEXT_PUBLIC_API_BASE=http://localhost:8000   # 백엔드 주소. 배포는 Cloud Run URL
# NEXT_PUBLIC_KAKAO_JS_KEY=<...>        # 카카오 지도 SDK
