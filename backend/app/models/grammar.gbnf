# 출력 JSON 스키마를 강제하는 llama.cpp 문법 (GBNF)
# - 키 순서와 구분자는 학습 데이터 형식(json.dumps 기본값: ", " 와 ": ")과 같다
# - preset, transport, role, transport_after 는 허용값으로 제한한다
#   (preset 은 out_of_scope 요청에서 null 가능)
# - null 은 데이터에서 실제로 null 이 나온 필드에만 허용한다
# - participants 는 빈 배열 가능 (out_of_scope), constraints / missing 은 문자열 배열 (빈 배열 허용)
# - access / rendezvous 는 null 또는 객체, schedule_confirmed 는 null 또는 불리언

root ::= "{" "\"preset\": " preset ", \"datetime\": " nullable-string ", \"purpose\": " nullable-string ", \"destination\": " nullable-string ", \"participants\": " participants ", \"rendezvous\": " rendezvous ", \"access\": " access ", \"schedule_confirmed\": " nullable-bool ", \"constraints\": " string-list ", \"missing\": " string-list ", \"out_of_scope\": " bool "}"

preset ::= "\"ship_maintenance\"" | "\"si_deploy\"" | "null"

participants ::= "[" (participant (", " participant)*)? "]"

participant ::= "{\"name\": " string ", \"origin\": " nullable-string ", \"transport\": " transport ", \"pickup\": " nullable-string ", \"pickup_at\": " nullable-string ", \"unfamiliar\": " bool ", \"role\": " role "}"

transport ::= "\"car\"" | "\"transit\"" | "\"walk\"" | "null"

role ::= "\"site\"" | "\"vendor\"" | "\"colleague\"" | "\"client\""

rendezvous ::= "null" | "{\"name\": " string ", \"transport_after\": " transport-after "}"

transport-after ::= "\"car\"" | "\"transit\"" | "\"walk\""

access ::= "null" | "{\"required\": " bool ", \"applied\": " nullable-bool ", \"lead_min\": " nullable-int "}"

bool ::= "true" | "false"

nullable-bool ::= bool | "null"

nullable-int ::= integer | "null"

integer ::= [0-9]+

string-list ::= "[]" | "[" string (", " string)* "]"

nullable-string ::= string | "null"

string ::= "\"" char* "\""

char ::= [^"\\\x7F\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
