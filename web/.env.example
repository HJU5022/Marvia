# 화면(Next.js)용 키 목록. 실제 값은 web/.env에만 적는다 (커밋 금지). `cp .env.example .env` 뒤 채운다.
# 셋 다 브라우저에 그대로 보이는 값이다(NEXT_PUBLIC_). 서버 비밀 키(SUPABASE_SECRET_KEY, OPENROUTER_API_KEY 등)는 절대 넣지 않는다 (SDD 7절).
# 값은 빌드할 때 들어가므로 바꾸면 npm run dev를 다시 켠다. 레포 루트 .env는 백엔드용이라 화면은 읽지 않는다.

# 백엔드 주소 (lib/api.ts). 비우면 백엔드 없이 lib/fixtures 가공 데이터 데모로 뜬다
# 로컬: http://localhost:8000 (docker compose up) / 배포: Railway API 주소
NEXT_PUBLIC_API_BASE=

# 로그인 (lib/auth.ts, web/README.md "로그인 (G3)"). 백엔드 .env에 SUPABASE_URL이 있으면 로그인이 켜져 있어 두 값이 필요하다
# Supabase 대시보드 > Project Settings > API Keys: 프로젝트 URL과 publishable 키(sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
