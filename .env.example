# 로컬 Postgres (docker compose의 db 서비스)
MARVIA_DATABASE_URL=postgresql://marvia:marvia@localhost:5433/marvia
# LLM: Anthropic API (Claude Haiku 5.5). hajeongun.dev 계정의 Anthropic Console에서 키를 만든다
MARVIA_ANTHROPIC_API_KEY=
# LLM을 부르는 길: api(기본, Anthropic API 키) 또는 cli(구독의 `claude -p`, 키 없음). cli로 잰 값은 결과에 따로 표시된다
MARVIA_LLM_VIA=
# cli 길의 호출별 CLI 원본 출력을 남길 폴더(저장소 밖). 비우면 남기지 않는다
MARVIA_CLI_LOG=
# 임베딩·리랭커: Voyage AI. hajeongun.dev 계정의 Voyage 대시보드에서 키를 만든다
MARVIA_VOYAGE_API_KEY=
# 에이전트 루프: agent(도구 루프), planner(고정 계획자, 기준선), supervisor(수퍼바이저와 서브에이전트 셋). 비우면 agent
MARVIA_LOOP=
# 승인 모드: ask(저장 전에 묻기) 또는 auto(바깥 발송만 묻기). 비우면 ask
MARVIA_PERMISSION_MODE=
# 저장 데이터 암호화 키(감시 목록 번호, 대화 기록). 만들기: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MARVIA_DATA_KEY=

# 로컬 Neo4j (docker compose의 neo4j 서비스). 비우면 bolt://localhost:7688, 비밀번호 marvia-local
MARVIA_NEO4J_URL=
MARVIA_NEO4J_PASSWORD=

# 검색 때 법령 그래프 확장: off(기본) 또는 on. on이면 Neo4j가 떠 있어야 한다 (scripts/build_graph.py)
MARVIA_GRAPH=

# UNI-PASS 화물통관진행정보: replay(기본, 가공 재생 데이터) 또는 live(실제 API, 키 필요). 평가는 늘 replay
MARVIA_UNIPASS_MODE=
# UNI-PASS OpenAPI 인증키(crkyCn). 로그·화면·LLM에 찍지 않는다
MARVIA_UNIPASS_KEY=

# 배 추적 (계획 8a). 비워 두면 재생 데이터(fixtures/mof, fixtures/shipfinder)만 읽고 바깥을 부르지 않는다.
# 실제 조회는 MODE를 live로 두고 키를 넣을 때만 한다. 아직 그래프에 연결하지 않아 화면의 답은 달라지지 않는다.
MARVIA_MOF_MODE=
# 공공데이터포털 키(해수부 선박운항정보·관제정보). MARVIA_DATA_KEY(저장 데이터 암호화 키)와 다른 값이다
MARVIA_MOF_KEY=
# 해외 서버에서 해수부를 부를 때의 서울 릴레이 주소와 토큰(relay/README.md). 한국에서 직접 부르면 비워 둔다
MARVIA_MOF_BASE_URL=
MARVIA_MOF_RELAY_TOKEN=
MARVIA_SHIPFINDER_MODE=
MARVIA_SHIPFINDER_KEY=

# 에이전트 RAG의 검색 길: mcp(기본, 같은 MCP 서버를 메모리 통로로) 또는 direct
MARVIA_RAG_VIA=
# 규정 검색 MCP HTTP 서버(scripts/serve_mcp.py)의 Bearer 토큰. 비면 서버가 뜨지 않는다
MARVIA_MCP_TOKEN=

# 그래프 시험이 붙는 시험용 Neo4j (docker compose의 neo4j-test). 비우면 bolt://localhost:7689. 개발 주소와 같으면 시험이 실패한다
MARVIA_NEO4J_TEST_URL=

# 화면 서버(계획 4b) 로그인: supabase(기본, Supabase Auth 토큰 ES256 확인) 또는 dev(이 컴퓨터에서만, 고정 토큰)
MARVIA_AUTH=
# Supabase 프로젝트 주소(https://<프로젝트>.supabase.co). 비밀이 아니다. supabase 모드에서 비면 서버가 뜨지 않는다
MARVIA_SUPABASE_URL=
# 쓸 수 있는 사용자 id(토큰의 sub)를 쉼표로. 목록 밖 사용자는 403
MARVIA_OWNER_IDS=
# auth=dev일 때 받는 고정 토큰. 운영(Cloud Run)에서는 dev 모드로 뜨지 않는다
MARVIA_DEV_TOKEN=
# 화면 주소. CORS는 이 origin만 연다. 비우면 http://localhost:3000
MARVIA_WEB_ORIGIN=
# 서버가 듣는 주소. 비우면 127.0.0.1. 컨테이너 안에서만 0.0.0.0으로 둔다(Dockerfile·compose가 준다)
MARVIA_HOST=

# 트레이스(Langfuse). 셋이 모두 있어야 켜진다. 비우면 꺼진다(기본). 보내는 값은 모두 화물 번호를 가린 값이다
# hajeongun.dev 계정의 Langfuse 프로젝트 설정에서 키를 만든다. 접두어 없는 LANGFUSE_* 이름은 쓰지 않는다(서버가 뜨지 않는다)
MARVIA_LANGFUSE_PUBLIC_KEY=
MARVIA_LANGFUSE_SECRET_KEY=
# Langfuse 주소. 예: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US), 직접 띄운 서버 주소
MARVIA_LANGFUSE_HOST=
